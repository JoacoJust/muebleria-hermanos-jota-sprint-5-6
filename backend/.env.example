# Connection string de MongoDB Atlas (reemplazá USUARIO, PASSWORD y CLUSTER).
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/muebleria-jota?retryWrites=true&w=majority

# Puerto del servidor Express.
PORT=4000

# URL del frontend registrada en el navegador para CORS (deploy o desarrollo).
CLIENT_URL=http://localhost:3000
